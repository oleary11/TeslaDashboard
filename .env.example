ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
JWT_SECRET=
TESLA_EMAIL=
TESLA_VIN=

# Tesla Fleet API credentials
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://your-domain.example/api/auth/callback

# Optional commute geofences
HOME_LAT=
HOME_LON=
WORK_LAT=
WORK_LON=

# Optional EIA fuel-price data
EIA_API_KEY=

# Public Fleet Telemetry endpoint
TELEMETRY_HOST=telemetry.your-domain.example
TELEMETRY_PORT=4443

# Optional, only if the API is called cross-origin
CORS_ORIGINS=

# User whose direct SCP/rsync folders are indexed (default: first user)
DASHCAM_DIRECT_USER_ID=1

# Optional total storage cap for data/dashcam, in GB. 0 or unset = unlimited.
# When exceeded, RecentClips/SentryClips events are deleted oldest-first
# (SavedClips are never auto-deleted). Checked every 15 minutes.
DASHCAM_MAX_STORAGE_GB=0

# When true, SentryClips are treated like SavedClips and never auto-deleted
# by the storage cap; only RecentClips are pruned. Default false.
DASHCAM_PROTECT_SENTRY=false

# Host directory containing TLS certificates used by fleet-telemetry
LETSENCRYPT_PATH=./letsencrypt
